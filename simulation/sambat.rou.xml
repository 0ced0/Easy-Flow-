<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- D incoming -->
    <route id="D_to_A" edges="E2 -E1"/>
    <route id="D_to_B" edges="E2 E0"/>
    <route id="D_to_C" edges="E2 -E3"/>

    <!-- A incoming -->
    <route id="A_to_D" edges="E1 -E2"/>
    <route id="A_to_B" edges="E1 E0"/>
    <route id="A_to_C" edges="E1 -E3"/>

    <!-- B incoming -->
    <route id="B_to_D" edges="-E0 -E2"/>
    <route id="B_to_A" edges="-E0 -E1"/>
    <route id="B_to_C" edges="-E0 -E3"/>

    <!-- C incoming -->
    <route id="C_to_D" edges="E3 -E2"/>
    <route id="C_to_A" edges="E3 -E1"/>
    <route id="C_to_B" edges="E3 E0"/>


    <!-- TEST TRAFFIC -->

    <flow id="D_A_flow"
          route="D_to_A"
          begin="0"
          end="600"
          vehsPerHour="100"/>

