# Never commit a real .env.local file. It is ignored by .gitignore.
# Use a separate development database so local video processing cannot alter live data.
EASYFLOW_ENV=local
EASYFLOW_VIDEO_SOURCE=local
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_NAME=easyflow_local
# Optional MP4 overrides. If omitted, scripts/run-local.ps1 supplies the four
# bundled recordings from server/videoData. These variables are required when
# starting server/local_app.py directly.
# EASYFLOW_STOL_VIDEO=C:\path\to\sambat_to_lspu.mp4
# EASYFLOW_STOP_VIDEO=C:\path\to\sambat_to_patimbao.mp4
# EASYFLOW_STOS_VIDEO=C:\path\to\sambat_to_sunstar.mp4
# EASYFLOW_STOC_VIDEO=C:\path\to\sambat_to_complex.mp4
