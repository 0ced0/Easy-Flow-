# Never commit a real .env.local file. It is ignored by .gitignore.
# Use a separate development database so local video processing cannot alter live data.
EASYFLOW_ENV=local
EASYFLOW_VIDEO_SOURCE=local
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_NAME=easyflow_local
